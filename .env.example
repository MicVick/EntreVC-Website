# EntreVC Web — environment variables
# Copy to .env.local for development. On the VM, place a .env in the app directory
# readable only by the service user (chmod 600).
#
# NOTHING secret may use the NEXT_PUBLIC_ prefix — those are inlined into the browser
# bundle and are readable by anyone who visits the site.

# ─── Core ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for canonical URLs, OG tags, .ics links
# and the links inside transactional email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# libSQL/SQLite connection. Local file in development.
# On the VM use an absolute path on LOCAL disk, never an NFS mount — SQLite
# corrupts on network filesystems. If the VM's storage is NFS, switch the adapter
# to Postgres (see EXECUTION_PLAN.md §3, decision 7).
DATABASE_URI=file:./data/entrevc.db

# ─── Payload ─────────────────────────────────────────────────────────────────
# Signs auth tokens. Generate with: openssl rand -base64 32
# Changing this invalidates every logged-in admin session.
PAYLOAD_SECRET=

# ─── Email (institute SMTP relay) ────────────────────────────────────────────
# Confirmation emails, contact acknowledgements and routing notifications.
# Deliverability also needs SPF, DKIM and DMARC on the sending domain — that is a
# DNS task, not a code task, and it blocks nothing until launch week.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@entrevc.in
SMTP_FROM_NAME=EntreVC, IIM Ahmedabad
# Where contact-form notifications go when a category has no specific mailbox set
# in Site Settings. Category routing is edited in the admin, not here.
CONTACT_FALLBACK_EMAIL=

# ─── Media ───────────────────────────────────────────────────────────────────
# Absolute path on the VM for uploaded files. Defaults to ./public/media in dev.
# This directory is part of the nightly backup — see deploy/backup.sh.
MEDIA_DIR=

# ─── Analytics (optional; the site runs fine without it) ─────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Seeding ─────────────────────────────────────────────────────────────────
# First admin user created by `npm run seed`. Development only — on production the
# first user is created through the /admin signup screen on first boot.
SEED_ADMIN_EMAIL=admin@entrevc.local
SEED_ADMIN_PASSWORD=
